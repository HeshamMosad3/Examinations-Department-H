<!DOCTYPE html>
<html lang="@(T.IsArabic ? "ar" : "en")" dir="@T.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] is string title ? $"{title} · " : "")@T["Brand"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&display=swap" rel="stylesheet" />
    <link href="@(T.IsArabic ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root { --brand: #1b5743; --brand-mid: #2a7f62; --brand-light: #7ee8c7; --ink: #0d1110; --muted: #636363; --line: #e0e0e0; --bg: #f6f8f7; }
        body { font-family: 'Almarai', system-ui, sans-serif; background: var(--bg); color: var(--ink); overflow-x: hidden; }
        .btn-brand { background: var(--brand); border-color: var(--brand); color: #fff; }
        .btn-brand:hover, .btn-brand:focus, .btn-brand:active { background: var(--brand-mid) !important; border-color: var(--brand-mid) !important; color: #fff !important; }
        .btn-brand:disabled { background: var(--brand); border-color: var(--brand); color: #fff; opacity: .55; }
        a { color: var(--brand); }
        .brand-mark { color: var(--brand); font-weight: 800; letter-spacing: .3px; }
        .panel-shell { min-height: calc(100vh - 57px); }
        .nav-pills .nav-link { color: var(--ink); }
        .nav-pills .nav-link:hover:not(.active) { background: #eef3f1; }
        .nav-pills .nav-link.active { color: #fff; }
        .nw { white-space: nowrap; }
        .validation-summary-valid { display: none !important; }
        .panel-aside { width: 250px; flex: 0 0 250px; }
        .panel-main { min-width: 0; flex: 1 1 auto; }
        .nav-header { list-style: none; }
        @@media (max-width: 991.98px) { .panel-aside { width: 280px; flex-basis: auto; } }
        /* Tables become cards on a phone: each cell shows its own label. */
        @@media (max-width: 767.98px) {
            .rtable thead { display: none; }
            .rtable, .rtable tbody, .rtable tr, .rtable td { display: block; width: 100%; }
            .rtable tr { border-bottom: 1px solid var(--line); padding: .6rem .9rem; }
            .rtable tr:last-child { border-bottom: 0; }
            .rtable td { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .3rem 0; border: 0; text-align: end; background: transparent; }
            .rtable td::before { content: attr(data-label); color: var(--muted); font-size: .8rem; text-align: start; flex-shrink: 0; }
            .rtable td.actions { justify-content: flex-end; }
            .rtable td.actions::before { content: none; }
        }
    </style>

</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">
    <main class="w-100" style="max-width: 420px">
        <div class="text-end mb-2">
            <a class="small text-decoration-none" asp-controller="Account" asp-action="Language" asp-route-culture="@(T.IsArabic ? "en" : "ar")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@T["LanguageSwitch"]</a>
        </div>
        @RenderBody()
    </main>
</body>
</html>

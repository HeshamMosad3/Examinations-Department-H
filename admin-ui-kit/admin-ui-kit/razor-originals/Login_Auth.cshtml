@model LoginViewModel
@{
    Layout = "_Auth";
    ViewData["Title"] = T["SignIn"];
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h1 class="h4 brand-mark mb-1"><i class="bi bi-shield-check"></i> @T["Brand"]</h1>
        <p class="text-muted mb-4">@T["SignInHint"]</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger py-2" role="alert">@Model.Error</div>
        }

        <form method="post" asp-action="Login" autocomplete="on">
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" for="Email">@T["Email"]</label>
                <input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" autocomplete="username" dir="ltr" required autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label" for="Password">@T["Password"]</label>
                <input class="form-control" type="password" id="Password" name="Password" autocomplete="current-password" dir="ltr" required />
            </div>
            <button class="btn btn-brand w-100" type="submit">@T["SignIn"]</button>
        </form>
    </div>
</div>

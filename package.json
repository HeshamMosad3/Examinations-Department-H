{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build --config vite.landing.config.js",
        "watch": "vite build --watch --config vite.landing.config.js",
        "dev": "vite --config vite.landing.config.js",
        "dev:all": "concurrently -k -n \"laravel,vite\" -c \"cyan,magenta\" \"php artisan serve\" \"npm run dev\""
    },
    "devDependencies": {
        "@fontsource/cairo": "5.3.0",
        "@fontsource/el-messiri": "5.3.0",
        "@fortawesome/fontawesome-free": "6.5.1",
        "@popperjs/core": "2.11.8",
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "10.6.0",
        "axios": "^1.11.0",
        "bootstrap": "5.3.3",
        "canvas-confetti": "1.9.4",
        "chart.js": "4.5.1",
        "concurrently": "^9.0.1",
        "jquery": "3.7.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "8.5.28",
        "tailwindcss": "^4.0.0",
        "tailwindcss-v3": "npm:tailwindcss@3.4.19",
        "vite": "^7.0.7"
    },
    "allowScripts": {
        "@fortawesome/fontawesome-free@6.5.1": true,
        "esbuild@0.28.2": true
    }
}
